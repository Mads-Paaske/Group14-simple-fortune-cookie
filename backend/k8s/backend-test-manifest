apiVersion: apps/v1
kind: Deployment
metadata:
  name: backend-test
  labels:
    app: backend
    version: test
spec:
  replicas: 1
  selector:
    matchLabels:
      app: backend
      version: test
  template:
    metadata:
      labels:
        app: backend
        version: test
    spec:
      containers:
        - name: backend
          image: ghcr.io/mads-paaske/fortune-backend:latest
          imagePullPolicy: Always
          ports:
            - containerPort: 9000
          resources:
            requests:
              cpu: "100m"
              memory: "64Mi"
            limits:
              cpu: "250m"
              memory: "128Mi"
          env:
          - name: REDIS_DNS
            value: "redis"
---
apiVersion: v1
kind: Service
metadata:
  name: backend-test
  labels:
    app: backend
    version: test
spec:
  selector:
    app: backend
    version: test
  ports:
    - port: 9000
      targetPort: 9000
  type: ClusterIP