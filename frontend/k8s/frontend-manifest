apiVersion: apps/v1
kind: Deployment
metadata:
  name: frontend-v1
  labels:
    app: frontend
    version: v1
spec:
  replicas: 2
  selector:
    matchLabels:
      app: frontend
      version: v1
  template:
    metadata:
      labels:
        app: frontend
        version: v1
    spec:
      containers:
        - name: frontend
          image: ghcr.io/mads-paaske/fortune-frontend:latest
          imagePullPolicy: Always
          ports:
            - containerPort: 8080
          env:
            - name: BACKEND_DNS
              value: "backend-v1"
            - name: BACKEND_PORT
              value: "9000"
          resources:
            requests:
              cpu: "100m"
              memory: "64Mi"
            limits:
              cpu: "250m"
              memory: "128Mi"
---
apiVersion: v1
kind: Service
metadata:
  name: frontend-v1
  labels:
    app: frontend
    version: v1
spec:
  selector:
    app: frontend
    version: v1
  ports:
    - port: 80
      targetPort: 8080
  type: NodePort